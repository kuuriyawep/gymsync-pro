# Optional overrides for local development against a different Supabase
# project or branch. Safe to leave unset — src/lib/supabaseClient.js falls
# back to the production project's public URL and publishable key.
#
# Never put SUPABASE_SERVICE_ROLE_KEY here. That secret lives only in
# Base44 backend function secrets and Supabase Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
