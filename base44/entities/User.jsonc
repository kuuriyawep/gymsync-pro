{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Base44 platform role",
      "enum": [
        "admin",
        "user"
      ]
    },
    "app_role": {
      "type": "string",
      "description": "GymSync business role",
      "enum": [
        "owner",
        "staff",
        "member"
      ]
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "photo_url": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "role"
  ]
}